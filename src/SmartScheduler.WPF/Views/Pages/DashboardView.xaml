<Page x:Class="SmartScheduler.WPF.Views.Pages.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      Background="{DynamicResource BackgroundBrush}"
      Title="DashboardView">

    <Grid Background="{StaticResource BackgroundBrush}"
          Height="Auto"
          Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10 "
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Background="{DynamicResource BackgroundBrush}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Margin="5">
                <Calendar x:Name="MainCalendar"
                          FontSize="14"
                          BorderThickness="0"
                          Background="White"
                          DisplayDate="{x:Static sys:DateTime.Today}"
                          SelectedDate="{x:Static sys:DateTime.Today}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          SelectedDatesChanged="MainCalendar_SelectedDatesChanged">
                    <Calendar.Resources>
                        <Style x:Key="CustomCalendarDayButtonStyle" TargetType="CalendarDayButton">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Margin" Value="10 0 10 0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CalendarDayButton">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="40"
                                                Height="40">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2563EB" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#DCEBFF" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#DCEBFF" />
                                            </Trigger>
                                            <Trigger Property="IsInactive" Value="True">
                                                <Setter Property="Foreground" Value="#A0A0A0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="MonthYearTextStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Calendar.Resources>

                    <Calendar.CalendarDayButtonStyle>
                        <StaticResource ResourceKey="CustomCalendarDayButtonStyle" />
                    </Calendar.CalendarDayButtonStyle>
                </Calendar>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Margin="5"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Name="CurrentDate"
                               Text="No date selected"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      PanningMode="VerticalOnly"
                                      Height="250"
                                      Margin="0,8,0,0"
                                      Background="Transparent"
                                      CanContentScroll="False">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="2" CornerRadius="5">
                                                <StackPanel Orientation="Vertical" Margin="10 5">
                                                    <StackPanel Orientation="Horizontal" Margin="0 5">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   Margin="8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Time}"
                                                                   Margin="8,0"
                                                                   FontSize="10"
                                                                   Foreground="Gray"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="Gray"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <Button Name="planTasksBtn"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,16,0,0"
                            Focusable="True"
                            Click="planTasksBtn_Click">
                        <TextBlock Text="Plan Now" />
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Margin="5"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Quick stats"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="{Binding PlannedTime}"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Text="Planned time"
                                       FontSize="12"
                                       Foreground="Gray" />
                        </StackPanel>
                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="{Binding FreeTime}"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Text="Free time"
                                       FontSize="12"
                                       Foreground="Gray" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Efficiency}"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Text="Efficiency"
                                       FontSize="12"
                                       Foreground="Gray" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Margin="5"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Quick stats"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding QuickStats}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>