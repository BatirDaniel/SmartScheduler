<UserControl x:Class="SmartScheduler.WPF.Views.Controls.CustomCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Height="350" Width="400">
    <Border CornerRadius="8"
            BorderBrush="#DDD"
            BorderThickness="1"
            Background="White"
            Padding="16">

        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="PrevButton" Content="◀" Width="32" Height="32" Margin="5,0"
                        Click="PrevButton_Click" />
                <TextBlock x:Name="TitleText" Text="April 2024"
                           FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0" />
                <Button x:Name="NextButton" Content="▶" Width="32" Height="32" Margin="5,0"
                        Click="NextButton_Click" />
            </StackPanel>

            <Calendar x:Name="InnerCalendar"
                      DisplayDate="{x:Static sys:DateTime.Now}"
                      SelectedDate="{x:Static sys:DateTime.Now}"
                      Margin="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="16"
                      BorderThickness="0" />
        </StackPanel>
    </Border>
</UserControl>